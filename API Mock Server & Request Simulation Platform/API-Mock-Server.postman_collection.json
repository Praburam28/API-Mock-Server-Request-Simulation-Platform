              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Users API\",\n  \"http_method\": \"GET\",\n  \"endpoint_path\": \"/users\",\n  \"description\": \"Mock users endpoint\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/mock-apis",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mock-apis"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Mock APIs",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
