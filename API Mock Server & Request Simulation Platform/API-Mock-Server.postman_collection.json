              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Users API\",\n  \"http_method\": \"GET\",\n  \"endpoint_path\": \"/users\",\n  \"description\": \"Updated mock users endpoint\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/mock-apis/{{api_id}}",
